# ============================================================================
# FileInNOut - App-Only Deployment (External Storage via Tailscale + Home LAN)
# Target Server: 192.168.35.30 (2ser-opt서버, Gateway 192.168.35.1)
# ============================================================================

APP_VERSION=lan-prod
LAN_HOST_IP=192.168.35.30
APP_PORT=80
MINIO_RELAY_PORT=9000

# 1. 내부망(집 LAN) 접속 URL 설정
APP_FRONTEND_URL=http://192.168.35.30
APP_BACKEND_URL=http://192.168.35.30/api
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://192.168.35.30
APP_ADMIN_ONLY=false
APP_DEMO_ACCOUNT_ENABLED=false

# 2. 초기 관리자 계정 및 보안 키
ADMIN_EMAIL=admin@fileinnout.local
ADMIN_NAME=Administrator
ADMIN_PASSWORD=Qwer1234!ChangeMe
JWT_KEY=dGhpc19pc19hX3ZlcnlfbG9uZ19iYXNlNjRfc2VjcmV0X2tleV9mb3JfZmlsZWlubm91dF8yMDI2
PROJECT_AES_KEY=FileInNOutAesSecretKey202632Byte

# 3. 외부 MariaDB 연결 정보 (Tailscale 경유)
DB_HOST=100.81.241.98
DB_PORT=3306
DB_NAME=REPLACE_WITH_ISSUED_DB_NAME
DB_ID=REPLACE_WITH_ISSUED_DB_USER
DB_PASS=REPLACE_WITH_ISSUED_DB_PASSWORD

# 4. 외부 Redis 연결 정보 (Tailscale 경유)
REDIS_HOST=100.81.241.98
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=REPLACE_WITH_ISSUED_REDIS_PASSWORD
YJS_REDIS_PREFIX=fileinnout:yjs

# 5. 외부 MinIO 연결 정보 (Tailscale 경유 + LAN 무설치 단말 지원)
# - MINIO_API: 192.168.35.30 서버가 Tailscale로 직접 통신하는 내부 주소
# - MINIO_PUBLIC_API: 집 LAN 기기(Tailscale 미설치 PC/모바일)의 브라우저가 업로드/다운로드할 주소
#   * 외부 도메인이 있으면 해당 도메인(예: https://minio-stage.travelslegder.com) 입력
#   * 외부 도메인 없이 Tailscale 전용이면 http://192.168.35.30:9000 입력 (Nginx가 100.81.241.98:9000으로 자동 중계)
MINIO_API=http://100.81.241.98:9000
MINIO_PUBLIC_API=http://192.168.35.30:9000
MINIO_NAME=REPLACE_WITH_ISSUED_MINIO_ACCESS_KEY
MINIO_SECRET=REPLACE_WITH_ISSUED_MINIO_SECRET_KEY
MINIO_CLOUD_BUCKET=REPLACE_WITH_ISSUED_CLOUD_BUCKET
MINIO_WORKSPACE_BUCKET=REPLACE_WITH_ISSUED_WORKSPACE_BUCKET
MINIO_REGION=ap-northeast-2
